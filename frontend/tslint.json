{
  "defaultSeverity": "warning",
  "extends": [
    "tslint:recommended"
  ],
  "linterOptions": {
    "exclude": [
      "node_modules/**"
    ]
  },
  "rules": {
    "variable-name": [
      true,
      "allow-snake-case"
    ],
    "quotemark": [
      true,
      "single"
    ],
    "object-literal-sort-keys": false
  }
}
