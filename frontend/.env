# You can specify env variables by using the following files:
#
# .env                # loaded in all cases
# .env.local          # loaded in all cases, ignored by git
# .env.[mode]         # only loaded in specified mode
# .env.[mode].local   # only loaded in specified mode, ignored by git
#
# Note that only NODE_ENV, BASE_URL, and variables that start with
# VUE_APP_ will be statically embedded into the client bundle.
#
# More info at: https://cli.vuejs.org/guide/mode-and-env.html

PROXY_SERVER=127.0.0.1
PROXY_PORT=8000

VUE_APP_FAVICON            = 'https://www.comune.altamura.ba.it/templates/shaper_helixultimate/favicon.ico'
VUE_APP_CSS_URL            = 'https://unpkg.com/@picocss/pico@1.5.6/css/pico.min.css'
VUE_APP_CSS_THEME          = 'light'
VUE_APP_LANGUAGES          = 'it, en'
VUE_APP_HISTORY_MODE       = 'history'
VUE_APP_ADMIN_URL          = 'http://127.0.0.1:8000'
VUE_APP_SUITE_ORG_URL      = 'http://www.regione.puglia.it/'
VUE_APP_SUITE_ORG_NAME     = 'Regione Puglia'
VUE_APP_COOKIE_POLICY_URL  = '#'
VUE_APP_PRIVACY_POLICY_URL = '#'
VUE_APP_CREDITS_URL        = '#'