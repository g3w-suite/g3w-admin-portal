{
  "name": "g3w-portal",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "vue-cli-service lint",
    "serve": "npm run dev",
    "preversion": "npm run lint",
    "version": "npm run build && git add -A",
    "postversion": "git push && git push --tags",
    "test": "playwright test",
