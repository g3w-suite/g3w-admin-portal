    "test:gen": "playwright codegen",
    "test:report": "playwright show-report",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "platform": "1.3.6"
  },
  "dependencies": {
    "@fontsource/titillium-web": "^5.0.2",
